  initTournaments();
  initResults();
  initAuth();
  initProfilePage();
  initGuidesPage();
  initAdminPage();
  initConsultButtons();
});

function applyI18n() {
  document.documentElement.lang = LANG === 'en' ? 'en' : LANG === 'de' ? 'de' : 'ru';

  // Nav links (order: Home, Tournaments, Results, Sports dropdown)
  const navLinks = document.querySelectorAll('.nav-menu > li > a');
  if (navLinks.length >= 4) {
    if (navLinks[0] && !navLinks[0].classList.contains('dropdown-toggle')) navLinks[0].textContent = t('home');
    if (navLinks[1]) navLinks[1].textContent = t('tournaments');
    if (navLinks[2]) navLinks[2].textContent = t('results');
    const dd = document.querySelector('.dropdown-toggle');
    if (dd) {
      const icon = dd.querySelector('i');
      dd.innerHTML = t('sports') + ' ';
      if (icon) dd.appendChild(icon);
      else {
        const i = document.createElement('i');
        i.className = 'fas fa-chevron-down';
        i.style.fontSize = '0.75rem';
        dd.appendChild(i);
      }
    }
  }

  // Hero slides
  const slides = document.querySelectorAll('.slide');
  if (slides.length >= 3) {
    const h1 = slides[0].querySelector('h1');
    const p1 = slides[0].querySelector('p');
    const b1 = slides[0].querySelector('.btn');
    if (h1) h1.innerHTML = t('hero1').replace(/(ONLINE|ОНЛАЙН|ONLINE)/i, (m) => m).split(' ').length > 3
      ? (LANG === 'ru' ? 'ОНЛАЙН-<span>ТРЕНЕРЫ</span><br>ПО ВСЕМ ВИДАМ СПОРТА' : LANG === 'en' ? 'ONLINE <span>COACHES</span><br>FOR ALL MARTIAL ARTS' : 'ONLINE-<span>TRAINER</span><br>FÜR ALLE KAMPFSPORTARTEN')
      : t('hero1');
    if (LANG === 'ru' && h1) h1.innerHTML = 'ОНЛАЙН-<span>ТРЕНЕРЫ</span><br>ПО ВСЕМ ВИДАМ СПОРТА';
    if (LANG === 'en' && h1) h1.innerHTML = 'ONLINE <span>COACHES</span><br>FOR ALL MARTIAL ARTS';
    if (LANG === 'de' && h1) h1.innerHTML = 'ONLINE-<span>TRAINER</span><br>FÜR ALLE KAMPFSPORTARTEN';
    if (p1) p1.textContent = t('hero1sub');
    if (b1) b1.innerHTML = '<i class="fas fa-dumbbell"></i> ' + t('start');

    const h2 = slides[1].querySelector('h1');
    const p2 = slides[1].querySelector('p');
    const b2 = slides[1].querySelector('.btn');
    if (LANG === 'ru' && h2) h2.innerHTML = 'ПСИХОЛОГИЧЕСКАЯ<br><span>ПОДДЕРЖКА</span> СПОРТСМЕНА';
    if (LANG === 'en' && h2) h2.innerHTML = 'ATHLETE<br><span>PSYCHOLOGICAL</span> SUPPORT';
    if (LANG === 'de' && h2) h2.innerHTML = 'PSYCHOLOGISCHE<br><span>UNTERSTÜTZUNG</span>';
    if (p2) p2.textContent = t('hero2sub');
    if (b2) b2.innerHTML = '<i class="fas fa-brain"></i> ' + t('psych');

    const h3 = slides[2].querySelector('h1');
    const p3 = slides[2].querySelector('p');
    const b3 = slides[2].querySelector('.btn');
    if (LANG === 'ru' && h3) h3.innerHTML = 'ТУРНИРЫ И<br><span>СОРЕВНОВАНИЯ</span>';
    if (LANG === 'en' && h3) h3.innerHTML = 'TOURNAMENTS &<br><span>COMPETITIONS</span>';
    if (LANG === 'de' && h3) h3.innerHTML = 'TURNIERE &<br><span>WETTBEWERBE</span>';
    if (p3) p3.textContent = t('hero3sub');
    if (b3) b3.innerHTML = '<i class="fas fa-trophy"></i> ' + t('seeTournaments');
  }

  // Section titles
  document.querySelectorAll('.section-title').forEach(el => {
    const txt = el.textContent || '';
    if (/УСЛУГ|SERVICES|DIENSTE/i.test(txt) || el.closest('.section') && !el.closest('.contact-section')) {
      if (el.closest('#contact') || el.closest('.contact-section')) {
        el.innerHTML = LANG === 'ru' ? 'ОСТАВЬ <span>ЗАЯВКУ</span>' : LANG === 'en' ? 'LEAVE A <span>REQUEST</span>' : 'ANFRAGE <span>SENDEN</span>';
      } else if (/ЗАЯВК|REQUEST|ANFRAGE/i.test(txt)) {
        el.innerHTML = LANG === 'ru' ? 'ОСТАВЬ <span>ЗАЯВКУ</span>' : LANG === 'en' ? 'LEAVE A <span>REQUEST</span>' : 'ANFRAGE <span>SENDEN</span>';
      } else {
        el.innerHTML = LANG === 'ru' ? 'НАШИ <span>УСЛУГИ</span>' : LANG === 'en' ? 'OUR <span>SERVICES</span>' : 'UNSERE <span>DIENSTE</span>';
      }
    }
  });
  document.querySelectorAll('.section-subtitle').forEach(el => {
    const parent = el.closest('.section');
    if (parent && parent.classList.contains('contact-section')) el.textContent = t('contactSub');
    else if (parent && parent.querySelector('.services-grid')) el.textContent = t('servicesSub');
  });

  // Contact section specifically
  const contactTitle = document.querySelector('.contact-section .section-title');
  if (contactTitle) contactTitle.innerHTML = LANG === 'ru' ? 'ОСТАВЬ <span>ЗАЯВКУ</span>' : LANG === 'en' ? 'LEAVE A <span>REQUEST</span>' : 'ANFRAGE <span>SENDEN</span>';
  const contactSub = document.querySelector('.contact-section .section-subtitle');
  if (contactSub) contactSub.textContent = t('contactSub');

  // Form labels
  const labelMap = { name: t('name'), email: t('email'), whatsapp: t('whatsapp'), instagram: t('instagram') };
  document.querySelectorAll('#contact-form label[for]').forEach(lab => {
    const f = lab.getAttribute('for');
    if (labelMap[f]) lab.textContent = labelMap[f] + (f === 'name' || f === 'email' ? ' *' : '');
  });
  const submitBtn = document.querySelector('#contact-form button[type="submit"]');
  if (submitBtn) submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> ' + (LANG === 'ru' ? 'Сохранить и отправить' : LANG === 'en' ? 'Save and send' : 'Speichern und senden');

  // Consult buttons text
  document.querySelectorAll('[data-consult="wa"]').forEach(btn => {
    btn.innerHTML = '<i class="fab fa-whatsapp"></i> WhatsApp +998 90 826 05 75';
  });
  document.querySelectorAll('[data-consult="ig"]').forEach(btn => {
    btn.innerHTML = '<i class="fab fa-instagram"></i> @' + INSTAGRAM;
  });

  // Page headers
  const pageH1 = document.querySelector('.page-header h1');
  if (pageH1) {
    const path = location.pathname.split('/').pop() || '';
    if (path.includes('tournaments')) pageH1.textContent = t('tournaments').toUpperCase();
    else if (path.includes('results')) pageH1.textContent = t('results').toUpperCase();
    else if (path.includes('profile')) pageH1.textContent = t('profile').toUpperCase();
    else if (path.includes('guides')) {
      const sport = new URLSearchParams(location.search).get('sport');
      if (!sport) pageH1.textContent = t('guides').toUpperCase();
    }
  }

  // Filter labels
  document.querySelectorAll('.filters label').forEach(lab => {
    const forId = lab.getAttribute('for') || '';
    if (forId.includes('sport')) lab.textContent = t('sport');
    if (forId.includes('date')) lab.textContent = t('dateFrom');
  });
  document.querySelectorAll('.sport-select option[value=""]').forEach(opt => { opt.textContent = t('allSports'); });
  const searchBtn = document.getElementById('search-tournaments') || document.getElementById('search-results');
  if (searchBtn) searchBtn.innerHTML = '<i class="fas fa-search"></i> ' + t('search');

  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (I18N[LANG] && I18N[LANG][key]) el.textContent = I18N[LANG][key];
  });
}

function initLangSwitcher() {
  const box = document.getElementById('lang-switcher');
  if (!box) return;
  box.innerHTML = `
    <button type="button" class="lang-btn ${LANG==='ru'?'active':''}" data-lang="ru">RU</button>
    <button type="button" class="lang-btn ${LANG==='en'?'active':''}" data-lang="en">EN</button>
    <button type="button" class="lang-btn ${LANG==='de'?'active':''}" data-lang="de">DE</button>`;
  box.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const next = btn.getAttribute('data-lang');
      if (!next || next === LANG) return;
      LANG = next;
      localStorage.setItem('ampLang', LANG);
      location.reload();
    });
  });
}

function initNav() {
  const burger = document.querySelector('.burger');
  const menu = document.querySelector('.nav-menu');
  if (burger && menu) burger.addEventListener('click', () => menu.classList.toggle('open'));
  document.querySelectorAll('.dropdown').forEach(dd => {
    const toggle = dd.querySelector('.dropdown-toggle');
    if (toggle) toggle.addEventListener('click', e => {
      if (window.innerWidth <= 900) { e.preventDefault(); dd.classList.toggle('active'); }
    });
  });
  const sportsMenu = document.getElementById('sports-dropdown');
  if (sportsMenu) {
    const list = sportsList();
    sportsMenu.innerHTML = list.map((s, i) =>
      `<a href="guides.html?sport=${encodeURIComponent(SPORT_KEYS[i])}">${s}</a>`
    ).join('');
  }
}

function initSlider() {
  const slides = document.querySelectorAll('.slide');
  const dots = document.querySelectorAll('.dot');
  if (!slides.length) return;
  let current = 0;
  function show(i) {
    slides.forEach((s, idx) => s.classList.toggle('active', idx === i));
    dots.forEach((d, idx) => d.classList.toggle('active', idx === i));
    current = i;
  }
  dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
  // Slow auto-advance: 10 seconds per slide
  setInterval(() => show((current + 1) % slides.length), 10000);
}

function buildConsultMessage(data) {
  const lines = [
    LANG === 'ru' ? 'Здравствуйте! Заявка с сайта A.M.P.company' : LANG === 'de' ? 'Hallo! Anfrage von A.M.P.company Website' : 'Hello! Request from A.M.P.company website',
    (LANG === 'ru' ? 'Имя: ' : 'Name: ') + (data.name || '—'),
    'Email: ' + (data.email || '—'),
    'WhatsApp: ' + (data.whatsapp || '—'),
    'Instagram: ' + (data.instagram || '—')
  ];
  return lines.join('\n');
}

function sendConsultToChannels(data) {
  const text = buildConsultMessage(data);
  const encoded = encodeURIComponent(text);
  // WhatsApp message
  window.open(`https://wa.me/${WHATSAPP}?text=${encoded}`, '_blank');
  // Gmail / email
  const subject = encodeURIComponent(LANG === 'ru' ? 'Заявка с сайта A.M.P.company' : 'Request from A.M.P.company');
  setTimeout(() => {
    window.open(`mailto:${CONTACT_EMAIL}?subject=${subject}&body=${encoded}`, '_blank');
  }, 400);
  // Instagram profile (DM cannot be prefilled via web link)
  setTimeout(() => {
    window.open(`https://www.instagram.com/${INSTAGRAM}/`, '_blank');
  }, 800);
}

function initContactForm() {
  const form = document.getElementById('contact-form');
  if (!form) return;
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const data = {
      name: form.name?.value.trim() || '',
      email: form.email?.value.trim() || '',
      whatsapp: form.whatsapp?.value.trim() || '',
      instagram: form.instagram?.value.trim() || '',
      savedAt: new Date().toISOString()
    };
    if (!data.name || !data.email) {
      alert(LANG === 'ru' ? 'Заполните имя и Gmail' : LANG === 'de' ? 'Name und E-Mail ausfüllen' : 'Fill name and email');
      return;
    }
    try {
      await api('/api/contact', { method: 'POST', body: JSON.stringify(data) });
    } catch (err) {
      console.warn('Contact save failed', err);
    }
    const success = document.getElementById('form-success');
    if (success) { success.classList.add('show'); setTimeout(() => success.classList.remove('show'), 5000); }
    sendConsultToChannels(data);
  });
}

function initConsultButtons() {
  document.querySelectorAll('[data-consult="wa"]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      const msg = encodeURIComponent(
        LANG === 'ru' ? 'Здравствуйте! Хочу консультацию по единоборствам (сайт A.M.P.company)'
        : LANG === 'de' ? 'Hallo! Ich möchte eine Beratung zu Kampfsport (A.M.P.company)'
        : 'Hello! I want a martial arts consultation (A.M.P.company website)'
      );
      window.open(`https://wa.me/${WHATSAPP}?text=${msg}`, '_blank');
    });
  });
  document.querySelectorAll('[data-consult="ig"]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      // Open Instagram + optional mailto for consult request
      window.open(`https://www.instagram.com/${INSTAGRAM}/`, '_blank');
      const msg = encodeURIComponent(
        LANG === 'ru' ? 'Здравствуйте! Хочу консультацию (Instagram / сайт A.M.P.company)'
        : 'Hello! I want a consultation (Instagram / A.M.P.company)'
      );
      setTimeout(() => {
        window.open(`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Consultation A.M.P.company')}&body=${msg}`, '_blank');
      }, 300);
    });
  });
}

function populateSportSelects() {
  const list = sportsList();
  document.querySelectorAll('.sport-select').forEach(select => {
    const cur = select.value;
    select.innerHTML = `<option value="">${t('allSports')}</option>` +
      list.map((s, i) => `<option value="${SPORT_KEYS[i]}">${s}</option>`).join('');
    if (cur) select.value = cur;
  });
}

function formatDate(dateStr) {
  const locale = LANG === 'en' ? 'en-US' : LANG === 'de' ? 'de-DE' : 'ru-RU';
  return new Date(dateStr).toLocaleDateString(locale, { day:'numeric', month:'long', year:'numeric' });
}

function initTournaments() {
  const container = document.getElementById('tournaments-list');
  if (!container) return;
  const params = new URLSearchParams(location.search);
  const sportParam = params.get('sport');
  const sportSelect = document.getElementById('filter-sport');
  if (sportParam && sportSelect) sportSelect.value = sportParam;

  function render(list) {
    if (!list.length) {
      container.innerHTML = `<div class="empty-state"><i class="fas fa-trophy"></i><p>${t('noTournaments')}</p></div>`;
      return;
    }
    container.innerHTML = list.map(x => `
      <div class="card">
        <div class="card-header">
          <span class="card-sport">${sportDisplay(x.sport)}</span>
          <span class="card-date"><i class="far fa-calendar"></i> ${formatDate(x.date)}</span>
        </div>
        <div class="card-body">
          <h3>${x.name}</h3>
          <div class="card-meta"><span><i class="fas fa-map-marker-alt"></i> ${x.location}</span></div>
          <p style="margin-top:12px;color:var(--text-muted);font-size:0.9rem;">${x.info}</p>
        </div>
        <div class="card-footer">
          <span class="badge badge-open">${t('info')}</span>
          <span style="color:var(--text-muted);font-size:0.85rem;"><i class="far fa-clock"></i> ${formatDate(x.date)}</span>
        </div>
      </div>`).join('');
  }
  function filter() {
    const sport = document.getElementById('filter-sport')?.value || '';
    const date = document.getElementById('filter-date')?.value || '';
    let f = TOURNAMENTS;
    if (sport) f = f.filter(x => x.sport === sport);
    if (date) f = f.filter(x => x.date >= date);
    render(f);
  }
  document.getElementById('search-tournaments')?.addEventListener('click', filter);
  filter();
}

function initResults() {
  const tableBody = document.getElementById('results-body');
  if (!tableBody) return;
  function render(list) {
    if (!list.length) {
      tableBody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-muted);">${t('noTournaments')}</td></tr>`;
      return;
    }
    tableBody.innerHTML = list.map(r => `
      <tr>
        <td><span class="card-sport" style="font-size:0.75rem;">${sportDisplay(r.sport)}</span></td>
        <td>${r.event}</td>
        <td>${formatDate(r.date)}</td>
        <td class="place-1">${r.winner}</td>
        <td>${r.second}</td>
        <td>${r.score}</td>
      </tr>`).join('');
  }
  function filter() {
    const sport = document.getElementById('filter-sport-results')?.value || '';
    let f = RESULTS;
    if (sport) f = f.filter(r => r.sport === sport);
    render(f);
  }
  document.getElementById('search-results')?.addEventListener('click', filter);
  filter();
  initCharts();
}

function initCharts() {
  if (typeof Chart === 'undefined') return;
  const ctx1 = document.getElementById('chart-sports');
  if (ctx1) {
    new Chart(ctx1, {
      type: 'bar',
      data: { labels: CHART_SPORTS_COUNT.labels, datasets: [{ label: 'Tournaments', data: CHART_SPORTS_COUNT.data, backgroundColor: 'rgba(255,30,0,0.7)', borderColor: '#ff1e00', borderWidth: 1, borderRadius: 4 }] },
      options: { responsive: true, plugins: { legend: { labels: { color: '#fff' } } }, scales: { y: { beginAtZero: true, ticks: { color: '#a0a0a0' }, grid: { color: '#2a2a2a' } }, x: { ticks: { color: '#a0a0a0' }, grid: { color: '#2a2a2a' } } } }
    });
  }
  const ctx2 = document.getElementById('chart-wins');
  if (ctx2) {
    new Chart(ctx2, {
      type: 'doughnut',
      data: { labels: CHART_WINS.labels, datasets: [{ data: CHART_WINS.data, backgroundColor: ['#ff1e00','#ff6b00','#ffaa00','#00e676','#2196f3'], borderWidth: 0 }] },
      options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { color: '#fff', padding: 16 } } } }
    });
  }
}

function initAuth() { renderAuthUI(); createAuthModal(); }

function renderAuthUI() {
  const container = document.getElementById('auth-area');
  if (!container) return;
  if (isAdmin()) {
    container.innerHTML = `<div class="user-menu"><span class="user-name">${t('admin')} <span>jonibek0101</span></span><a href="admin.html" class="btn btn-primary">${t('panel')}</a><button class="btn btn-ghost" id="btn-logout">${t('logout')}</button></div>`;
    document.getElementById('btn-logout')?.addEventListener('click', () => { clearSession(); location.href='index.html'; });
    return;
  }
  const session = getSession();
  if (session) {
    container.innerHTML = `<div class="user-menu"><span class="user-name"><span>${session.name}</span></span><a href="profile.html" class="btn btn-ghost">${t('profile')}</a><button class="btn btn-ghost" id="btn-logout">${t('logout')}</button></div>`;
    document.getElementById('btn-logout')?.addEventListener('click', () => { clearSession(); location.reload(); });
  } else {
    container.innerHTML = `<div class="auth-buttons"><button class="btn btn-ghost" id="btn-login">${t('login')}</button><button class="btn btn-primary" id="btn-register">${t('register')}</button></div>`;
    document.getElementById('btn-login')?.addEventListener('click', () => openModal('login'));
    document.getElementById('btn-register')?.addEventListener('click', () => openModal('register'));
  }
}

function createAuthModal() {
  if (document.getElementById('auth-modal')) return;
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.id = 'auth-modal';
  overlay.innerHTML = `
    <div class="modal modal-wide">
      <button class="modal-close" id="modal-close">&times;</button>
      <div id="modal-login">
        <h2>${t('login').toUpperCase()}</h2>
        <p class="modal-sub">A.M.P.company</p>
        <div class="modal-error" id="login-error"></div>
        <form id="form-login">
          <div class="form-group"><label>${t('email')} / Admin</label><input type="text" id="login-email" placeholder="email@gmail.com" autocomplete="username" required></div>
          <div class="form-group"><label>${t('password')}</label><input type="password" id="login-password" placeholder="••••••••" autocomplete="current-password" required></div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:8px;"><i class="fas fa-sign-in-alt"></i> ${t('login')}</button>
        </form>
        <p class="modal-switch"><a id="switch-to-register">${t('register')}</a></p>
      </div>
      <div id="modal-register" style="display:none;">
        <h2>${t('register').toUpperCase()}</h2>
        <p class="modal-sub">1 Gmail = 1 account</p>
        <div class="modal-error" id="register-error"></div>
        <form id="form-register">
          <div class="form-group"><label>${t('name')}</label><input type="text" id="reg-name" required autocomplete="name"></div>
          <div class="form-group"><label>${t('email')}</label><input type="email" id="reg-email" placeholder="you@gmail.com" required autocomplete="email"></div>
          <div class="form-group"><label>${t('password')}</label><input type="password" id="reg-password" required minlength="6" autocomplete="new-password"></div>
          <div class="form-group"><label>${t('sport')}</label><select id="reg-sport" class="sport-select"><option value="">—</option></select></div>
          <div class="form-group"><label>${t('whatsapp')}</label><input type="text" id="reg-whatsapp" placeholder="+998..."></div>
          <div class="form-group"><label>${t('instagram')}</label><input type="text" id="reg-instagram" placeholder="@username"></div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:8px;"><i class="fas fa-user-plus"></i> ${t('register')}</button>
        </form>
        <p class="modal-switch"><a id="switch-to-login">${t('login')}</a></p>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  document.getElementById('modal-close').addEventListener('click', closeModal);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  document.getElementById('switch-to-register').addEventListener('click', () => openModal('register'));
  document.getElementById('switch-to-login').addEventListener('click', () => openModal('login'));
  document.getElementById('form-login').addEventListener('submit', handleLogin);
  document.getElementById('form-register').addEventListener('submit', handleRegister);
  const regSport = document.getElementById('reg-sport');
  if (regSport) {
    const list = sportsList();
    regSport.innerHTML = `<option value="">—</option>` + list.map((s,i) => `<option value="${SPORT_KEYS[i]}">${s}</option>`).join('');
  }
}

function openModal(type) {
  const o = document.getElementById('auth-modal');
  if (!o) return;
  document.getElementById('modal-login').style.display = type === 'login' ? 'block' : 'none';
  document.getElementById('modal-register').style.display = type === 'register' ? 'block' : 'none';
  document.getElementById('login-error')?.classList.remove('show');
  document.getElementById('register-error')?.classList.remove('show');
  o.classList.add('show');
}
function closeModal() { document.getElementById('auth-modal')?.classList.remove('show'); }

async function handleLogin(e) {
  e.preventDefault();
  const emailRaw = document.getElementById('login-email').value.trim();
  const password = document.getElementById('login-password').value;
  const errorEl = document.getElementById('login-error');
  if (errorEl) { errorEl.classList.remove('show'); errorEl.textContent = ''; }

  try {
    const data = await api('/api/auth/login', {
      method: 'POST',
      body: JSON.stringify({ email: emailRaw, password })
    });
    setToken(data.token);
    setSession(data.user);
    closeModal();
    if (data.user && data.user.isAdmin) {
      location.href = 'admin.html';
    } else {
      location.reload();
    }
  } catch (err) {
    errorEl.textContent = err.message || (LANG === 'ru' ? 'Неверный логин или пароль' : 'Wrong login or password');
    errorEl.classList.add('show');
  }
}

async function handleRegister(e) {
  e.preventDefault();
  const name = document.getElementById('reg-name').value.trim();
  const email = document.getElementById('reg-email').value.trim().toLowerCase();
  const password = document.getElementById('reg-password').value;
  const sport = document.getElementById('reg-sport').value;
  const whatsapp = document.getElementById('reg-whatsapp').value.trim();
  const instagram = document.getElementById('reg-instagram').value.trim();
  const errorEl = document.getElementById('register-error');
  if (password.length < 6) { errorEl.textContent = 'Min 6 characters'; errorEl.classList.add('show'); return; }

  try {
    const data = await api('/api/auth/register', {
      method: 'POST',
      body: JSON.stringify({ name, email, password, sport, whatsapp, instagram })
    });
    setToken(data.token);
    setSession(data.user);
    closeModal();
    location.reload();
  } catch (err) {
    errorEl.textContent = err.message || 'Registration failed';
    errorEl.classList.add('show');
  }
}

function initProfilePage() {
  const container = document.getElementById('profile-content');
  if (!container) return;
  const session = getSession();
  if (!session) {
    container.innerHTML = `<div class="empty-state"><i class="fas fa-user-lock"></i><p>${t('login')}</p><br><button class="btn btn-primary" onclick="openModal('login')">${t('login')}</button></div>`;
    return;
  }
  const initial = session.name.charAt(0).toUpperCase();
  const statusBadge = session.active !== false
    ? `<span class="badge badge-open">${t('active')}</span>`
    : `<span class="badge badge-closed">${t('inactive')}</span>`;
  container.innerHTML = `
    <div class="profile-card">
      <div class="profile-header">
        <div class="profile-avatar">${initial}</div>
        <h2>${session.name}</h2>
        <p>${session.email}</p>
        <div style="margin-top:12px;">${statusBadge}</div>
      </div>
      <div class="profile-body">
        <div class="profile-row"><span class="profile-label">${t('name')}</span><span class="profile-value">${session.name}</span></div>
        <div class="profile-row"><span class="profile-label">Email</span><span class="profile-value">${session.email}</span></div>
        <div class="profile-row"><span class="profile-label">${t('sport')}</span><span class="profile-value">${sportDisplay(session.sport||'')||'—'}</span></div>
        <div class="profile-row"><span class="profile-label">WhatsApp</span><span class="profile-value">${session.whatsapp||'—'}</span></div>
        <div class="profile-row"><span class="profile-label">Instagram</span><span class="profile-value">${session.instagram||'—'}</span></div>
        <div class="profile-row"><span class="profile-label">Status</span><span class="profile-value">${session.active!==false?t('active'):t('inactive')}</span></div>
      </div>
      <div class="profile-actions">
        <button class="btn btn-primary" id="profile-open-chat"><i class="fas fa-comments"></i> ${t('chatAdmin')}</button>
        <a href="tournaments.html" class="btn btn-ghost"><i class="fas fa-trophy"></i> ${t('tournaments')}</a>
        <button class="btn btn-ghost" id="profile-logout">${t('logout')}</button>
      </div>
    </div>`;
  document.getElementById('profile-logout')?.addEventListener('click', () => { clearSession(); location.href='index.html'; });
  // Personal chat per user email
  document.getElementById('profile-open-chat')?.addEventListener('click', () => {
    openChat('user_' + session.email, session.name);
  });
}

function initGuidesPage() {
  const container = document.getElementById('guides-content');
  if (!container) return;
  const sport = new URLSearchParams(location.search).get('sport');
  if (!sport || !GUIDES[sport]) {
    const list = sportsList();
    container.innerHTML = `
      <div class="empty-state"><i class="fas fa-book-open"></i><p>${t('selectSport')}</p></div>
      <div class="services-grid" style="margin-top:30px;">
        ${list.map((s,i) => `<a href="guides.html?sport=${encodeURIComponent(SPORT_KEYS[i])}" class="service-card" style="text-decoration:none;color:inherit;"><div class="service-icon"><i class="fas fa-fist-raised"></i></div><h3>${s}</h3><p>${t('guides')}</p></a>`).join('')}
      </div>`;
    return;
  }
  const titleEl = document.getElementById('guides-title');
  if (titleEl) titleEl.textContent = sportDisplay(sport);
  container.innerHTML = `<div class="services-grid">${GUIDES[sport].map((g,i) => `
    <div class="service-card"><div class="service-icon"><i class="fas fa-book"></i></div><h3>${i+1}. ${g.title}</h3><p>${g.desc}</p></div>
  `).join('')}</div>`;
}

// ===== CHAT — no auto-replies, personal per user =====
let currentChatId = null;
let pendingMedia = null;

function openChat(chatId, title) {
  if (!getSession() && !isAdmin()) { openModal('login'); return; }
  currentChatId = String(chatId);
  ensureChatUI();
  const h = document.getElementById('chat-title');
  const s = document.getElementById('chat-sub');
  if (h) h.textContent = title || 'Chat';
  if (s) s.textContent = isAdmin() ? 'Admin mode' : 'A.M.P.company';
  renderChatMessages();
  document.getElementById('chat-overlay')?.classList.add('show');
}

function ensureChatUI() {
  if (document.getElementById('chat-overlay')) return;
  const overlay = document.createElement('div');
  overlay.className = 'chat-overlay';
  overlay.id = 'chat-overlay';
  overlay.innerHTML = `
    <div class="chat-window">
      <div class="chat-header">
        <div class="chat-header-info"><h3 id="chat-title">Chat</h3><p id="chat-sub">A.M.P.company</p></div>
        <button class="chat-close" id="chat-close">&times;</button>
      </div>
      <div class="chat-messages" id="chat-messages"></div>
      <div class="chat-input-area">
        <div class="chat-preview" id="chat-preview"><button class="chat-preview-remove" id="chat-preview-remove">&times;</button><div id="chat-preview-media"></div></div>
        <div class="chat-input-row">
          <label class="chat-attach" title="Photo, video, audio, file"><i class="fas fa-paperclip"></i>
            <input type="file" id="chat-file" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.zip" hidden>
          </label>
          <input type="text" id="chat-text" placeholder="Text / link..." autocomplete="off">
          <button class="chat-send" id="chat-send"><i class="fas fa-paper-plane"></i></button>
        </div>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  document.getElementById('chat-close').addEventListener('click', closeChat);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeChat(); });
  document.getElementById('chat-send').addEventListener('click', sendChatMessage);
  document.getElementById('chat-text').addEventListener('keydown', e => { if (e.key === 'Enter') sendChatMessage(); });
  document.getElementById('chat-file').addEventListener('change', handleChatFile);
  document.getElementById('chat-preview-remove').addEventListener('click', clearPendingMedia);
}

function closeChat() {
  document.getElementById('chat-overlay')?.classList.remove('show');
  currentChatId = null;
  clearPendingMedia();
}

async function renderChatMessages() {
  const box = document.getElementById('chat-messages');
  if (!box || !currentChatId) return;
  let msgs = [];
  try {
    const data = await api('/api/chat/' + encodeURIComponent(currentChatId));
    msgs = data.messages || [];
  } catch (err) {
    box.innerHTML = `<div class="chat-empty"><i class="fas fa-exclamation-triangle"></i>${err.message || 'Error'}</div>`;
    return;
  }
  if (!msgs.length) {
    box.innerHTML = `<div class="chat-empty"><i class="fas fa-comments"></i>${LANG==='ru'?'Напишите сообщение':'Send a message'}</div>`;
    return;
  }
  box.innerHTML = msgs.map(m => {
    const time = new Date(m.time).toLocaleTimeString(LANG==='en'?'en-US':LANG==='de'?'de-DE':'ru-RU', { hour:'2-digit', minute:'2-digit' });
    let media = '';
    if (m.media) {
      if (m.mediaType === 'video') media = `<video src="${m.media}" controls playsinline></video>`;
      else if (m.mediaType === 'audio') media = `<audio src="${m.media}" controls style="width:100%;margin-top:6px;"></audio>`;
      else if (m.mediaType === 'file') media = `<a href="${m.media}" download="${m.fileName||'file'}" style="color:inherit;text-decoration:underline;display:block;margin-top:6px;"><i class="fas fa-file"></i> ${escapeHtml(m.fileName||'File')}</a>`;
      else media = `<img src="${m.media}" alt="">`;
    }
    let textHtml = '';
    if (m.text) {
      const linked = escapeHtml(m.text).replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;">$1</a>');
      textHtml = `<div class="msg-text">${linked}</div>`;
    }
    const side = m.from === 'me' ? 'me' : 'them';
    return `<div class="chat-msg ${side}">${textHtml}${media}<span class="msg-time">${time}</span></div>`;
  }).join('');
  box.scrollTop = box.scrollHeight;
}

async function sendChatMessage() {
  if (!currentChatId) return;
  const input = document.getElementById('chat-text');
  const text = (input?.value || '').trim();
  if (!text && !pendingMedia) return;
  try {
    await api('/api/chat/' + encodeURIComponent(currentChatId), {
      method: 'POST',
      body: JSON.stringify({
        text: text || '',
        media: pendingMedia?.dataUrl || null,
        mediaType: pendingMedia?.type || null,
        fileName: pendingMedia?.name || null
      })
    });
    if (input) input.value = '';
    clearPendingMedia();
    await renderChatMessages();
  } catch (err) {
    alert(err.message || 'Failed to send');
  }
}

function handleChatFile(e) {
  const file = e.target.files?.[0];
  if (!file) return;
  if (file.size > 10*1024*1024) { alert('Max 10 MB'); e.target.value=''; return; }
  let type = 'file';
  if (file.type.startsWith('image/')) type = 'image';
  else if (file.type.startsWith('video/')) type = 'video';
  else if (file.type.startsWith('audio/')) type = 'audio';
  const reader = new FileReader();
  reader.onload = () => {
    pendingMedia = { type, dataUrl: reader.result, name: file.name };
    const preview = document.getElementById('chat-preview');
    const mediaBox = document.getElementById('chat-preview-media');
    if (type === 'video') mediaBox.innerHTML = `<video src="${reader.result}" muted></video>`;
    else if (type === 'image') mediaBox.innerHTML = `<img src="${reader.result}" alt="">`;
    else if (type === 'audio') mediaBox.innerHTML = `<span style="font-size:0.85rem;"><i class="fas fa-music"></i> ${escapeHtml(file.name)}</span>`;
    else mediaBox.innerHTML = `<span style="font-size:0.85rem;"><i class="fas fa-file"></i> ${escapeHtml(file.name)}</span>`;
    preview.classList.add('show');
  };
  reader.readAsDataURL(file);
  e.target.value = '';
}

function clearPendingMedia() {
  pendingMedia = null;
  document.getElementById('chat-preview')?.classList.remove('show');
  const m = document.getElementById('chat-preview-media');
  if (m) m.innerHTML = '';
}

function escapeHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

async function initAdminPage() {
  const root = document.getElementById('admin-root');
  if (!root) return;
  if (!isAdmin()) {
    root.innerHTML = `<div class="empty-state"><i class="fas fa-shield-alt"></i><p>Admin only</p><br><button class="btn btn-primary" onclick="openModal('login')">${t('login')}</button></div>`;
    return;
  }

  root.innerHTML = `<div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading...</p></div>`;

  try {
    const [stats, usersData, chatsData] = await Promise.all([
      api('/api/admin/stats'),
      api('/api/admin/users'),
      api('/api/admin/chats')
    ]);
    const users = usersData.users || [];
    const chats = chatsData.chats || {};
    const chatKeys = Object.keys(chats);
    const daysList = Object.entries(stats.visitsDays || {}).sort((a,b)=>b[0].localeCompare(a[0])).slice(0,14)
      .map(([d,c]) => `<div class="profile-row"><span class="profile-label">${d}</span><span class="profile-value">${c}</span></div>`).join('') || '<p style="color:var(--text-muted);">—</p>';

    root.innerHTML = `
      <div class="charts-row" style="margin-bottom:30px;">
        <div class="chart-card"><h3><i class="fas fa-users" style="color:var(--accent);margin-right:8px;"></i> Users</h3><p style="font-size:2.5rem;font-family:'Bebas Neue';color:var(--accent);">${stats.usersCount||0}</p></div>
        <div class="chart-card"><h3><i class="fas fa-eye" style="color:var(--accent);margin-right:8px;"></i> Visits</h3><p style="font-size:2.5rem;font-family:'Bebas Neue';color:var(--accent);">${stats.visitsTotal||0}</p></div>
        <div class="chart-card"><h3><i class="fas fa-comments" style="color:var(--accent);margin-right:8px;"></i> Chats</h3><p style="font-size:2.5rem;font-family:'Bebas Neue';color:var(--accent);">${stats.chatsCount||0}</p></div>
      </div>
      <h2 class="section-title" style="font-size:2rem;text-align:left;margin-bottom:20px;">USERS</h2>
      <div class="results-table-wrap" style="margin-bottom:40px;overflow-x:auto;">
        <table>
          <thead><tr><th>Name</th><th>Email</th><th>Sport</th><th>WhatsApp</th><th>Instagram</th><th>Status</th><th></th></tr></thead>
          <tbody>
            ${users.length ? users.map(u => `
              <tr>
                <td>${escapeHtml(u.name)}</td>
                <td>${escapeHtml(u.email)}</td>
                <td>${escapeHtml(sportDisplay(u.sport||'')||'—')}</td>
                <td>${escapeHtml(u.whatsapp||'—')}</td>
                <td>${escapeHtml(u.instagram||'—')}</td>
                <td>${u.active!==false?'<span class="badge badge-open">'+t('active')+'</span>':'<span class="badge badge-closed">'+t('inactive')+'</span>'}</td>
                <td><button class="btn btn-outline admin-toggle-status" data-id="${escapeHtml(u.id||u.email)}" style="padding:6px 12px;font-size:0.8rem;">${u.active!==false?'OFF':'ON'}</button>
                <button class="btn btn-primary admin-open-user-chat" data-email="${escapeHtml(u.email)}" data-name="${escapeHtml(u.name)}" style="padding:6px 12px;font-size:0.8rem;margin-left:6px;"><i class="fas fa-comments"></i></button></td>
              </tr>`).join('') : '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--text-muted);">No users</td></tr>'}
          </tbody>
        </table>
      </div>
      <h2 class="section-title" style="font-size:2rem;text-align:left;margin-bottom:20px;">VISITS BY DAY</h2>
      <div class="profile-card" style="margin-bottom:40px;"><div class="profile-body">${daysList}</div></div>
      <h2 class="section-title" style="font-size:2rem;text-align:left;margin-bottom:20px;">CHATS</h2>
      <div class="cards-grid">
        ${chatKeys.length ? chatKeys.map(key => {
          const msgs = chats[key]||[];
          const last = msgs[msgs.length-1];
          const preview = last ? (last.text || '['+(last.mediaType||'media')+']') : '…';
          return `<div class="card"><div class="card-header"><span class="card-sport">Chat</span><span class="card-date">${msgs.length}</span></div>
            <div class="card-body"><h3 style="font-size:1rem;word-break:break-all;">${escapeHtml(key.replace('user_',''))}</h3>
            <p style="color:var(--text-muted);font-size:0.85rem;margin-top:8px;">${escapeHtml(String(preview).slice(0,60))}</p></div>
            <div class="card-footer"><button class="btn btn-primary admin-open-chat" data-chatid="${escapeHtml(key)}" style="padding:8px 16px;font-size:0.85rem;">${t('openChat')}</button></div></div>`;
        }).join('') : '<div class="empty-state"><i class="fas fa-comments"></i><p>No chats yet</p></div>'}
      </div>`;

    root.querySelectorAll('.admin-toggle-status').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        try {
          await api('/api/admin/users/' + encodeURIComponent(id) + '/toggle', { method: 'POST' });
          initAdminPage();
        } catch (err) {
          alert(err.message || 'Error');
        }
      });
    });
    root.querySelectorAll('.admin-open-chat').forEach(btn => {
      btn.addEventListener('click', () => openChat(btn.getAttribute('data-chatid'), btn.getAttribute('data-chatid')));
    });
    root.querySelectorAll('.admin-open-user-chat').forEach(btn => {
      btn.addEventListener('click', () => {
        const email = btn.getAttribute('data-email');
        const name = btn.getAttribute('data-name');
        openChat('user_' + email, name);
      });
    });
  } catch (err) {
    root.innerHTML = `<div class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>${escapeHtml(err.message||'Error')}</p><br><button class="btn btn-primary" onclick="openModal('login')">${t('login')}</button></div>`;
  }
