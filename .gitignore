<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Результаты — A.M.P.company</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="css/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
  <!-- HEADER -->
  <header class="header">
    <div class="nav-container">
      <a href="index.html" class="logo">
        <i class="fas fa-bolt"></i>
        A.M.P.<span>company</span>
      </a>
      <nav>
        <ul class="nav-menu">
          <li><a href="index.html">Главная</a></li>
          <li><a href="tournaments.html">Турниры</a></li>
          <li><a href="results.html" class="active">Результаты</a></li>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle">Виды спорта <i class="fas fa-chevron-down" style="font-size:0.75rem;"></i></a>
            <div class="dropdown-menu" id="sports-dropdown">
              <!-- filled by JS -->
            </div>
          </li>
        </ul>
      </nav>
      <div class="lang-switcher" id="lang-switcher"></div>
      <div id="auth-area"></div>
      <div class="burger">
        <span></span><span></span><span></span>
      </div>
    </div>
  </header>

  <!-- PAGE HEADER -->
  <div class="page-header">
    <h1>РЕЗУЛЬТАТЫ</h1>
    <p>Результаты по всем видам единоборств и спортивной борьбы</p>
  </div>

  <section class="section" style="padding-top:20px;">
    <!-- CHARTS -->
    <div class="charts-row">
      <div class="chart-card">
        <h3><i class="fas fa-chart-bar" style="color:var(--accent);margin-right:8px;"></i> Турниры по видам спорта</h3>
        <canvas id="chart-sports" height="220"></canvas>
      </div>
      <div class="chart-card">
        <h3><i class="fas fa-trophy" style="color:var(--accent);margin-right:8px;"></i> Победы клубов (футбол)</h3>
        <canvas id="chart-wins" height="220"></canvas>
      </div>
    </div>

    <!-- FILTERS -->
    <div class="filters">
      <div class="filter-group">
        <label for="filter-sport-results">Вид спорта</label>
        <select id="filter-sport-results" class="sport-select">
          <option value="">Все виды единоборств</option>
        </select>
      </div>
      <div class="filter-group" style="flex:0;min-width:auto;">
        <label>&nbsp;</label>
        <button class="btn btn-primary" id="search-results">
          <i class="fas fa-search"></i> Применить фильтр
        </button>
      </div>
    </div>

    <!-- RESULTS TABLE -->
    <div class="results-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Вид спорта</th>
            <th>Турнир / Событие</th>
            <th>Дата</th>
            <th>Победитель</th>
            <th>2 место</th>
            <th>Счёт / Результат</th>
          </tr>
        </thead>
        <tbody id="results-body">
          <!-- filled by JS -->
        </tbody>
      </table>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-logo">A.M.P.<span>company</span></div>
    <p>Online coaches • Psychology • Martial arts</p>
    <div class="socials">
      <a href="#"><i class="fab fa-instagram"></i></a>
      <a href="#"><i class="fab fa-whatsapp"></i></a>
      <a href="#"><i class="fab fa-telegram"></i></a>
      <a href="#"><i class="fab fa-youtube"></i></a>
    </div>
    <p class="copyright">© 2026 A.M.P.company. Все права защищены.</p>
  </footer>

  <script src="js/script.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
