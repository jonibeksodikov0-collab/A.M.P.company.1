let LANG = localStorage.getItem('ampLang') || 'ru';
function t(key) { return (I18N[LANG] && I18N[LANG][key]) || I18N.ru[key] || key; }
function sportsList() { return ALL_SPORTS[LANG] || ALL_SPORTS.ru; }
function sportKeyByIndex(i) { return SPORT_KEYS[i] || SPORT_KEYS[0]; }
function sportDisplay(key) {
  const i = SPORT_KEYS.indexOf(key);
  if (i < 0) return key;
  return (ALL_SPORTS[LANG] || ALL_SPORTS.ru)[i] || key;
}

