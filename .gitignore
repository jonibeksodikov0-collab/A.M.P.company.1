# A.M.P.company — Secure Version

Server-side authentication. Secrets (admin password, hidden token, JWT secret) live **only on the server**.

## Quick start (local)

```bash
cd amp-secure
cp .env.example .env   # already done if you use the provided .env
npm install
npm start
```

Open: http://localhost:3000

### Admin login
- Login: `jonibek0101`
- Password: `almaz2005`
- Or use the **HIDDEN_TOKEN** (from `.env`) in either field

## What was improved

| Before (old)              | Now (secure)                          |
|---------------------------|---------------------------------------|
| Passwords in localStorage | bcrypt hashes on server               |
| Admin login in public JS  | Admin credentials only in `.env`      |
| Hidden token in browser   | Token only on server                  |
| Anyone can read secrets   | Rate limiting + JWT sessions          |

## Deploy on American servers

### 1. Railway (recommended, easy, US region)

1. Go to https://railway.app → New Project → Deploy from GitHub (or upload ZIP)
2. Set **Root Directory** to the folder with `package.json`
3. Add environment variables (from `.env.example`):
   - `JWT_SECRET` = long random string
   - `ADMIN_LOGIN` = jonibek0101
   - `ADMIN_PASS` = your strong password
   - `HIDDEN_TOKEN` = another long random string
   - `PORT` = 3000 (Railway sets it automatically)
4. Choose region **US West / US East** if available
5. Deploy → you get a public HTTPS URL

### 2. Render.com (US)

1. https://render.com → New → Web Service
2. Connect repo or upload
3. Build: `npm install`
4. Start: `npm start`
5. Region: **Oregon (US West)**
6. Add the same environment variables

### 3. Fly.io (US regions)

```bash
fly launch
fly secrets set JWT_SECRET=... ADMIN_LOGIN=... ADMIN_PASS=... HIDDEN_TOKEN=...
fly regions set ord   # Chicago, USA
fly deploy
```

### 4. DigitalOcean / AWS / VPS (any US city)

```bash
# On the server (Ubuntu)
git clone <your-repo>
cd amp-secure
npm install
# put .env with secrets
npm start
# or use pm2:
npm i -g pm2
pm2 start server.js --name amp
```

## Important

- **Never** put `JWT_SECRET`, `ADMIN_PASS` or `HIDDEN_TOKEN` into frontend JS.
- Change all default passwords before going public.
- Data is stored in `data/*.json` (users, chats, visits). For production you can later switch to PostgreSQL / MongoDB.

## API endpoints

- `POST /api/auth/login`
- `POST /api/auth/register`
- `GET  /api/auth/me`
- `GET  /api/admin/users` (admin)
- `POST /api/admin/users/:id/toggle` (admin)
- `GET  /api/admin/stats` (admin)
- `GET  /api/admin/chats` (admin)
- `GET/POST /api/chat/:chatId`
- `POST /api/contact`

/**
 * A.M.P.company — Secure Backend
 * Run: npm install && npm start
 * Deploy on US regions: Railway, Render, Fly.io, DigitalOcean, AWS
 */

try { require('dotenv').config(); } catch (e) {}
const express = require('express');
const path = require('path');
const fs = require('fs');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const cors = require('cors');
const rateLimit = require('express-rate-limit');

const app = express();
const PORT = process.env.PORT || 3000;
const JWT_SECRET = process.env.JWT_SECRET || 'CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING';
const ADMIN_LOGIN = process.env.ADMIN_LOGIN || 'jonibek0101';
const ADMIN_PASS_HASH = process.env.ADMIN_PASS_HASH || null; // preferred: pre-hashed
const ADMIN_PASS_PLAIN = process.env.ADMIN_PASS || 'almaz2005'; // fallback only for first run
const HIDDEN_TOKEN = process.env.HIDDEN_TOKEN || 'ZaEZbsAflMIcGAmwHr9dz1ZtJIw8pkN-uMhRw75HG9o';
const DATA_DIR = path.join(__dirname, 'data');
const USERS_FILE = path.join(DATA_DIR, 'users.json');
const CHATS_FILE = path.join(DATA_DIR, 'chats.json');
const VISITS_FILE = path.join(DATA_DIR, 'visits.json');

if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });

// ---------- helpers ----------
function readJson(file, fallback) {
  try {
    if (!fs.existsSync(file)) return fallback;
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return fallback;
  }
}
function writeJson(file, data) {
  fs.writeFileSync(file, JSON.stringify(data, null, 2), 'utf8');
}

function getUsers() {
  return readJson(USERS_FILE, []);
}
function saveUsers(users) {
  writeJson(USERS_FILE, users);
}
function getChats() {
  return readJson(CHATS_FILE, {});
}
function saveChats(chats) {
  writeJson(CHATS_FILE, chats);
}
function getVisits() {
  return readJson(VISITS_FILE, { total: 0, days: {} });
}
function saveVisits(v) {
  writeJson(VISITS_FILE, v);
}

async function ensureAdminHash() {
  // If no hash in env, we still accept plain for first boot, but prefer hashing on the fly
  return true;
}

// ---------- middleware ----------
app.use(cors({ origin: true, credentials: true }));
app.use(express.json({ limit: '2mb' }));
app.use(express.urlencoded({ extended: true }));

const authLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  max: 30,
  message: { error: 'Too many attempts. Try again later.' }
});

const apiLimiter = rateLimit({
  windowMs: 1 * 60 * 1000,
  max: 120
});

app.use('/api/', apiLimiter);

// Track visits
app.use((req, res, next) => {
  if (req.path.startsWith('/api/') || req.path.includes('.')) return next();
  const visits = getVisits();
  visits.total = (visits.total || 0) + 1;
  const day = new Date().toISOString().slice(0, 10);
  visits.days = visits.days || {};
  visits.days[day] = (visits.days[day] || 0) + 1;
  saveVisits(visits);
  next();
});

// Auth middleware
function authRequired(req, res, next) {
  const header = req.headers.authorization || '';
  const token = header.startsWith('Bearer ') ? header.slice(7) : null;
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const payload = jwt.verify(token, JWT_SECRET);
    req.user = payload;
    next();
  } catch {
    return res.status(401).json({ error: 'Invalid or expired token' });
  }
}

function adminRequired(req, res, next) {
  if (!req.user || !req.user.isAdmin) {
    return res.status(403).json({ error: 'Admin only' });
  }
  next();
}

// ---------- API: Auth ----------
app.post('/api/auth/login', authLimiter, async (req, res) => {
  try {
    const { email, password } = req.body || {};
    if (!email || !password) {
      return res.status(400).json({ error: 'Email and password required' });
    }

    const login = String(email).trim();
    const pass = String(password);

    // 1) Hidden token (either field)
    if (login === HIDDEN_TOKEN || pass === HIDDEN_TOKEN) {
      const token = jwt.sign(
        { isAdmin: true, name: 'Admin', email: 'admin@amp.local' },
        JWT_SECRET,
        { expiresIn: '12h' }
      );
      return res.json({ token, user: { name: 'Admin', email: 'admin@amp.local', isAdmin: true } });
    }

    // 2) Classic admin login
    const isAdminLogin =
      login === ADMIN_LOGIN || login.toLowerCase() === ADMIN_LOGIN.toLowerCase();

    if (isAdminLogin) {
      let ok = false;
      if (ADMIN_PASS_HASH) {
        ok = await bcrypt.compare(pass, ADMIN_PASS_HASH);
      } else {
        ok = pass === ADMIN_PASS_PLAIN || pass === HIDDEN_TOKEN;
      }
      if (ok) {
        const token = jwt.sign(
          { isAdmin: true, name: 'Admin', email: 'admin@amp.local' },
          JWT_SECRET,
          { expiresIn: '12h' }
        );
        return res.json({ token, user: { name: 'Admin', email: 'admin@amp.local', isAdmin: true } });
      }
    }

    // 3) Regular user
    const users = getUsers();
    const user = users.find(u => String(u.email || '').toLowerCase() === login.toLowerCase());
    if (!user) {
      return res.status(401).json({ error: 'Wrong login or password' });
    }
    if (user.active === false) {
      return res.status(403).json({ error: 'Account disabled by admin' });
    }

    const match = await bcrypt.compare(pass, user.passwordHash || '');
    if (!match) {
      return res.status(401).json({ error: 'Wrong login or password' });
    }

    const token = jwt.sign(
      {
        isAdmin: false,
        name: user.name,
        email: user.email,
        sport: user.sport || '',
        whatsapp: user.whatsapp || '',
        instagram: user.instagram || ''
      },
      JWT_SECRET,
      { expiresIn: '7d' }
    );

    res.json({
      token,
      user: {
        name: user.name,
        email: user.email,
        sport: user.sport || '',
        whatsapp: user.whatsapp || '',
        instagram: user.instagram || '',
        active: true,
        isAdmin: false
      }
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Server error' });
  }
});

app.post('/api/auth/register', authLimiter, async (req, res) => {
  try {
    const { name, email, password, sport, whatsapp, instagram } = req.body || {};
    if (!name || !email || !password) {
      return res.status(400).json({ error: 'Name, email and password required' });
    }
    if (String(password).length < 6) {
      return res.status(400).json({ error: 'Password min 6 characters' });
    }

    const emailNorm = String(email).toLowerCase().trim();
    const users = getUsers();
    if (users.find(u => u.email === emailNorm)) {
      return res.status(409).json({ error: '1 Gmail = 1 account' });
    }

    const passwordHash = await bcrypt.hash(String(password), 12);
    const newUser = {
      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 8),
      name: String(name).trim(),
      email: emailNorm,
      passwordHash,
      sport: sport || '',
      whatsapp: whatsapp || '',
      instagram: instagram || '',
      active: true,
      createdAt: new Date().toISOString()
    };
    users.push(newUser);
    saveUsers(users);

    const token = jwt.sign(
      {
        isAdmin: false,
        name: newUser.name,
        email: newUser.email,
        sport: newUser.sport,
        whatsapp: newUser.whatsapp,
        instagram: newUser.instagram
      },
      JWT_SECRET,
      { expiresIn: '7d' }
    );

    res.status(201).json({
      token,
      user: {
        name: newUser.name,
        email: newUser.email,
        sport: newUser.sport,
        whatsapp: newUser.whatsapp,
        instagram: newUser.instagram,
        active: true,
        isAdmin: false
      }
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Server error' });
  }
});

app.get('/api/auth/me', authRequired, (req, res) => {
  res.json({ user: req.user });
});

// ---------- API: Admin ----------
app.get('/api/admin/users', authRequired, adminRequired, (req, res) => {
  const users = getUsers().map(u => ({
    id: u.id,
    name: u.name,
    email: u.email,
    sport: u.sport || '',
    whatsapp: u.whatsapp || '',
    instagram: u.instagram || '',
    active: u.active !== false,
    createdAt: u.createdAt
  }));
  res.json({ users });
});

app.post('/api/admin/users/:id/toggle', authRequired, adminRequired, (req, res) => {
  const users = getUsers();
  const idx = users.findIndex(u => u.id === req.params.id || u.email === req.params.id);
  if (idx < 0) return res.status(404).json({ error: 'User not found' });
  users[idx].active = users[idx].active === false ? true : false;
  saveUsers(users);
  res.json({ active: users[idx].active });
});

app.get('/api/admin/stats', authRequired, adminRequired, (req, res) => {
  const users = getUsers();
  const chats = getChats();
  const visits = getVisits();
  res.json({
    usersCount: users.length,
    visitsTotal: visits.total || 0,
    visitsDays: visits.days || {},
    chatsCount: Object.keys(chats).length
  });
});

app.get('/api/admin/chats', authRequired, adminRequired, (req, res) => {
  const chats = getChats();
  res.json({ chats });
});

// ---------- API: Chat ----------
app.get('/api/chat/:chatId', authRequired, (req, res) => {
  const chatId = String(req.params.chatId);
  // User can only read own chat (unless admin)
  if (!req.user.isAdmin) {
    const expected = 'user_' + (req.user.email || '');
    if (chatId !== expected) {
      return res.status(403).json({ error: 'Forbidden' });
    }
  }
  const chats = getChats();
  res.json({ messages: chats[chatId] || [] });
});

app.post('/api/chat/:chatId', authRequired, (req, res) => {
  const chatId = String(req.params.chatId);
  if (!req.user.isAdmin) {
    const expected = 'user_' + (req.user.email || '');
    if (chatId !== expected) {
      return res.status(403).json({ error: 'Forbidden' });
    }
  }

  const { text, media, mediaType, fileName } = req.body || {};
  if (!text && !media) {
    return res.status(400).json({ error: 'Empty message' });
  }

  const from = req.user.isAdmin ? 'them' : 'me';
  const msg = {
    from,
    text: text || '',
    media: media || null,
    mediaType: mediaType || null,
    fileName: fileName || null,
    time: new Date().toISOString()
  };

  const chats = getChats();
  if (!chats[chatId]) chats[chatId] = [];
  chats[chatId].push(msg);
  if (chats[chatId].length > 500) chats[chatId] = chats[chatId].slice(-500);
  saveChats(chats);

  res.json({ ok: true, message: msg });
});

// ---------- Contact form (optional save) ----------
app.post('/api/contact', authLimiter, (req, res) => {
  const contactsFile = path.join(DATA_DIR, 'contacts.json');
  const list = readJson(contactsFile, []);
  list.push({
    ...req.body,
    receivedAt: new Date().toISOString()
  });
  writeJson(contactsFile, list);
  res.json({ ok: true });
});

// ---------- Static files ----------
app.use(express.static(path.join(__dirname, 'public')));

// SPA-like fallback for clean URLs (optional)
app.get('*', (req, res) => {
  const file = path.join(__dirname, 'public', req.path === '/' ? 'index.html' : req.path);
  if (fs.existsSync(file) && fs.statSync(file).isFile()) {
    return res.sendFile(file);
  }
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

app.listen(PORT, () => {
  console.log(`A.M.P.company secure server running on port ${PORT}`);
  console.log(`Open http://localhost:${PORT}`);
  if (!process.env.JWT_SECRET) {
    console.warn('WARNING: JWT_SECRET is not set in .env — using fallback (insecure for production)');
  }
});

